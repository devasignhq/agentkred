{
    "name": "@agentkred/server",
    "version": "0.0.0",
    "private": true,
    "license": "Apache-2.0",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "start": "tsx src/index.ts",
        "worker": "tsx src/config/worker.ts",
        "db:up": "docker compose up -d --wait",
        "db:migrate": "prisma migrate deploy",
        "db:generate": "prisma generate",
        "journal:rebuild": "tsx src/scripts/journalRebuild.ts",
        "journal:verify": "tsx src/scripts/journalVerify.ts",
        "postinstall": "prisma generate",
        "typecheck": "tsc --noEmit",
        "test": "npm run test:unit && npm run test:db",
        "test:unit": "vitest run tests/unit",
        "test:db": "dotenv -e .env.test -- prisma migrate deploy && dotenv -e .env.test -- vitest run tests/db",
        "test:testnet": "dotenv -e .env.test -- prisma migrate deploy && vitest run tests/testnet"
    },
    "dependencies": {
        "@agentkred/shared": "0.0.0",
        "@prisma/adapter-pg": "7.10.1",
        "@prisma/client": "7.10.1",
        "@stellar/stellar-sdk": "17.3.0",
        "dotenv": "17.4.2",
        "express": "5.3.0",
        "pg": "8.23.1",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@types/express": "5.0.6",
        "@types/node": "24.19.2",
        "@types/pg": "8.23.1",
        "@types/supertest": "7.2.1",
        "dotenv-cli": "10.0.0",
        "prisma": "7.10.1",
        "supertest": "7.3.2",
        "tsx": "4.23.15",
        "typescript": "6.0.3",
        "vitest": "5.0.5"
    }
}
