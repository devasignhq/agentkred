# Postgres, from `npm run db:up`
DATABASE_URL=postgresql://agentkred:agentkred@localhost:5433/agentkred

# HTTP port for the API
PORT=8080

# Stellar network: RPC endpoint and the deployed escrow contract
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
ESCROW_CONTRACT_ID=CAHINXFZT6KHRRPRSZ7YN5VN75QS7KBGW5NKW5QBKJV6ZIN2IROQFFVM

# First ledger the journal reads events from; defaults to the oldest ledger the RPC still holds
INGEST_START_LEDGER=

# AgentKred's XLM-only operator keys: the channel account that sources calls and the account that pays fee-bumps
CHANNEL_SECRET=
FEE_SECRET=

# Allow http webhooks and private addresses such as 127.0.0.1; for local development only, never in production
WEBHOOK_ALLOW_INSECURE=false
